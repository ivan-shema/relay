# Postgres connection. With the bundled docker-compose this is ready to go.
DATABASE_URL="postgresql://relay:relay@localhost:5432/relay?schema=public"

# Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Mock integration toggles (kept on while no real providers are wired)
MOCK_PAYMENTS=true
MOCK_OTP=true
# In mock OTP mode every code is accepted, and this fixed code always works:
MOCK_OTP_CODE=000000
