# Postgres connection. With the bundled docker-compose this is ready to go.
DATABASE_URL="postgresql://relay:relay@localhost:5432/relay?schema=public"

# Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Paypack — real MTN MoMo / Airtel Money for wallet top-ups and payouts.
# Create an application at https://payments.paypack.rw to get these. Leave
# empty to keep the instant mock provider for deposits/withdrawals.
PAYPACK_CLIENT_ID=""
PAYPACK_CLIENT_SECRET=""
# Webhook signing secret from the application's webhook config (used to verify
# POST /webhooks/paypack). Point the webhook URL at <api-origin>/webhooks/paypack.
PAYPACK_WEBHOOK_SECRET=""
# Which webhook mode Paypack should trigger for our transactions
PAYPACK_MODE="development"

# SMTP for notification emails (every in-app notification is also emailed).
# Leave SMTP_HOST empty to log emails to the API console instead (mock mode).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Relay <no-reply@relay.app>"

# Google sign-in — OAuth 2.0 "Web application" client ID from
# https://console.cloud.google.com/apis/credentials. Add the web origin
# (http://localhost:3000) under "Authorized JavaScript origins". The same ID
# goes in apps/web/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave empty to
# disable Google sign-in (the button is hidden on the web).
GOOGLE_CLIENT_ID=""

# Media storage — Cloudinary for KYC documents (private, served only through the
# authenticated /documents route) and profile pictures (public CDN URLs).
# Dashboard → Settings → API keys. Leave all three empty to store files on local
# disk under apps/api/uploads/ instead (dev only — hosts like Render wipe the
# disk on every deploy). Free Cloudinary accounts block PDF delivery until you
# enable "Allow delivery of PDF and ZIP files" under Settings → Security.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Public base URL of this API, used to build local-disk profile picture URLs.
API_PUBLIC_URL="http://localhost:5000"
